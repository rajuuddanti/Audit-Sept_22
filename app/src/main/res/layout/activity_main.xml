<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF7F6"
    android:fillViewport="true"
    tools:ignore="HardcodedText,UseCompoundDrawables,Autofill,VisualLintBounds,TextFields,ButtonSize">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER BAR -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D0021B"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSubHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.15"
                    android:text="MAHALAXMI MAHAMART"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stock Audit"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- HEADER ICONS & TOGGLE -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- SKU SEARCH MODE TOGGLE SWITCH -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSkuSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    app:thumbTint="#FFFFFF"
                    app:trackTint="#FFCDD2" />

                <ImageButton
                    android:id="@+id/btnHistory"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="History"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_history"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Settings"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings_sliders"
                    app:tint="#FFFFFF" />
            </LinearLayout>
        </RelativeLayout>

        <!-- FORM CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- BARCODE FIELD (DEFAULT MODE) -->
            <TextView
                android:id="@+id/tvBarcodeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.1"
                android:text="BARCODE"
                android:textColor="#D0021B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etBarcode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/red_input_bg"
                android:fontFamily="@font/calibri_regular"
                android:hint="Scan or enter barcode"
                android:imeOptions="actionNext"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:nextFocusDown="@id/etQuantity"
                android:nextFocusForward="@id/etQuantity"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="#111111"
                android:textColorHint="#555555"
                android:textSize="14sp" />

            <!-- PREDICTIVE SKU SEARCH FIELD (SHOWN ONLY WHEN TOGGLE IS ON) -->
            <TextView
                android:id="@+id/tvSkuSearchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.1"
                android:text="SEARCH ITEM NAME"
                android:textColor="#D0021B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <com.mahamart.mahamartaudit.PersistentAutoCompleteTextView
                android:id="@+id/actvSkuSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/red_input_bg"
                android:completionThreshold="2"
                android:dropDownVerticalOffset="4dp"
                android:fontFamily="@font/calibri_regular"
                android:hint="Type product name (e.g. FLAIR PEN)..."
                android:imeOptions="actionNext"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:popupBackground="@drawable/dropdown_bg"
                android:textColor="#111111"
                android:textColorHint="#555555"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- QUANTITY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.1"
                android:text="QUANTITY"
                android:textColor="#D0021B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etQuantity"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/red_input_bg"
                    android:fontFamily="@font/calibri_regular"
                    android:gravity="center_vertical"
                    android:hint="Enter qty"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLines="1"
                    android:nextFocusDown="@id/etBarcode"
                    android:nextFocusForward="@id/etBarcode"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="#111111"
                    android:textColorHint="#555555"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#D0021B"
                    android:focusable="false"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:text="–"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

                <Button
                    android:id="@+id/btnPlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#D0021B"
                    android:focusable="false"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/red_button_bg"
                android:elevation="6dp"
                android:letterSpacing="0.15"
                android:stateListAnimator="@null"
                android:text="SEND"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <!-- RACK NO & DEVICE ID SIDE BY SIDE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:letterSpacing="0.1"
                        android:text="RACK NO"
                        android:textColor="#D0021B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etRackNo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/red_input_bg"
                        android:fontFamily="@font/calibri_regular"
                        android:hint="Rack No"
                        android:inputType="text"
                        android:paddingHorizontal="14dp"
                        android:textColor="#111111"
                        android:textColorHint="#555555"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:letterSpacing="0.1"
                        android:text="DEVICE ID"
                        android:textColor="#D0021B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etDeviceId"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/red_input_bg"
                        android:enabled="false"
                        android:focusable="false"
                        android:fontFamily="@font/calibri_regular"
                        android:hint="Device ID"
                        android:inputType="text"
                        android:paddingHorizontal="14dp"
                        android:textColor="#555555"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- DATE & TIME -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:letterSpacing="0.1"
                        android:text="DATE"
                        android:textColor="#D0021B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/red_input_bg"
                        android:fontFamily="@font/calibri_regular"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:letterSpacing="0.1"
                        android:text="TIME"
                        android:textColor="#D0021B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/red_input_bg"
                        android:fontFamily="@font/calibri_regular"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:background="#D0021B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Scans"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="SKU/EAN"
                    android:textColor="#D0021B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="QTY"
                    android:textColor="#D0021B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:text="Rack"
                    android:textColor="#D0021B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:gravity="end"
                    android:text="Time"
                    android:textColor="#D0021B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginBottom="10dp"
                android:background="#D0021B" />

            <LinearLayout
                android:id="@+id/containerRecentScans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>