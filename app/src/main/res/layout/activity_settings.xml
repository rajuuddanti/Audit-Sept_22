<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Red Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D32F2F"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAHALAXMI MAHAMART"
                android:textColor="#FFCDD2"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Store Configuration"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- STORE NAME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STORE NAME"
                android:textColor="#B71C1C"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etStoreName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@android:drawable/editbox_background"
                android:hint="Store Name"
                android:inputType="textCapWords"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#111111"
                android:textColorHint="#999999"
                android:textSize="15sp"
                android:fontFamily="@font/calibri_regular" />

            <!-- DEVICE ID -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="DEVICE ID"
                android:textColor="#B71C1C"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDeviceIdSetting"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@android:drawable/editbox_background"
                android:hint="Device ID"
                android:inputType="textCapCharacters"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#111111"
                android:textColorHint="#999999"
                android:textSize="15sp"
                android:fontFamily="@font/calibri_regular" />

            <!-- RACK NUMBER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="RACK NUMBER"
                android:textColor="#B71C1C"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRackNoSetting"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@android:drawable/editbox_background"
                android:hint="e.g. RACK-01"
                android:inputType="textCapCharacters"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#111111"
                android:textColorHint="#999999"
                android:textSize="15sp"
                android:fontFamily="@font/calibri_regular" />

            <!-- SAVE SETTINGS BUTTON -->
            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#B71C1C"
                android:text="SAVE SETTINGS"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="#E0E0E0" />

            <!-- SKU MASTER IMPORT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SKU MASTER MANAGEMENT"
                android:textColor="#B71C1C"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnImportExcelOffline"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#B71C1C"
                android:text="IMPORT EXCEL / CSV FILE (OFFLINE)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

            <ProgressBar
                android:id="@+id/progressBarImport"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="100"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvImportStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Importing..."
                android:textColor="#008000"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvMasterCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Total Master SKUs: 0"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- OPEN RECYCLE BIN BUTTON -->
            <Button
                android:id="@+id/btnGoToBin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#FF9800"
                android:text="OPEN RECYCLE BIN"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>