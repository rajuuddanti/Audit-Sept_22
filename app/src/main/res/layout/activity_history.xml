<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5"
    android:orientation="vertical">

    <!-- Top Red Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D32F2F"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAHALAXMI MAHAMART"
                android:textColor="#FFCDD2"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan History"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotalCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Total Scans: 0"
                android:textColor="#FFCDD2"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cloud Sync Button (Placed Left of Email Button) -->
        <ImageButton
            android:id="@+id/btnSyncCloud"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sync to Cloud"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/stat_notify_sync"
            app:tint="#FFFFFF" />

        <!-- Email CSV Export Button -->
        <ImageButton
            android:id="@+id/btnExportCsv"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Export CSV to Email"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_dialog_email"
            app:tint="#FFFFFF" />

        <!-- Clear All Button -->
        <ImageButton
            android:id="@+id/btnClearAll"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear All History"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <ListView
        android:id="@+id/lvHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#E0E0E0"
        android:dividerHeight="1dp"
        android:padding="8dp" />

</LinearLayout>